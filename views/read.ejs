<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<style>
      * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-wrap: wrap;
                /* justify-content: center; */
                /* align-items: center; */
            background: #1c1c1c;
        }

        .user{
            margin: 50px;
            height: 450px;
            width: 370px;
            background: #252525;
            /* text-align: center; */
            /* color: white; */
            
        }
     .image {
    height: 300px;
    width: 370px;
    background-color: aliceblue;
    overflow: hidden;
}

.image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
}
      
        .naam{
            padding-top: 10px;
            padding-left: 10px;
            color: white;
        }
        .mail{
            padding-left: 10px;
            color: #b5b4b4;
        }
        .actions{

            padding-top: 3px;
            padding-left: 10px;
        }
        .actions a{
            text-decoration: none;
            
        }
        .edit{
            color: blue;
            
        }
        .del{
            color: rgb(165, 0, 0);
        }
        .edit-btn{
            height: 40px;
            width: 70px;
            background-color: blue;
            color: white;
            border: none;
            border-radius:20px;
            
        }
        .edit-btn a{
            font-size: 17px;
            color: white;
        }
          .del-btn{
            height: 40px;
            width: 70px;
            background-color: rgb(232, 34, 34);
            color: white;
            border: none;
            border-radius:20px;
            
        }
        .del-btn a{
            font-size: 17px;
            color: white;
        }

</style>
<body>
    <% users.forEach(function(user){ %>
        <div class="user">
             <div class = "image">
                <img src="<%= user.image %>" alt="">
             </div>
        <h2 class="naam"><%= user.name %></h2>
        <h4 class="mail"><%=user.email %></h4><br>

        <div class="actions">
            <button class="edit-btn"><a class="edit" href="/edit/<%= user._id%>">Edit</a></button>
            <button class="del-btn"><a class="del" href="">Delete</a></button>
        </div>
        </div>
     <%  }) %>
    
    
</body>
</html>