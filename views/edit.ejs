<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register User</title>

    <style>
         * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-wrap: wrap;
                justify-content: center;
                align-items: center;
            background: #1c1c1c;
        }

      

        .form-container {
            width: 400px;
            background: rgb(15, 15, 15);
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        h2 {
            text-align: center;
            margin-bottom: 25px;
            color: #ffffff;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
            font-weight: 600;
            color: #ffffff;
        }

        input {
            width: 100%;
            padding: 12px;
            /* border: 1px solid #ddd; */
            border-radius: 7px;
            border: none;
            font-size: 14px;
            /* outline: none; */
            background-color: #1c1c1c;
            color: white;
        }

        input:active {
            border-color: #fbfbfb;
        }

        input[type="file"] {
            padding: 10px;
            background: #1c1c1c;
        }

        button {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 7px;
            background: #007bff;
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 5px;
        }

        button:hover {
            background: #0069d9;
        }
        .r-link{
            text-decoration: none;
            color: #007bff;
            
        }
    </style>
</head>

<body>

    

    <div class="form-container">
        <a class="r-link" href="/read">All Users</a>
        <h2>Edit User</h2>

        <form action="/update/<%= user._id %>" method="POST">

            <div class="form-group">
                <label for="name">Name</label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    placeholder="Enter your name"
                    required
                    value="<%= user.name %>"
                >
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    placeholder="Enter your email"
                    required
                    value="<%= user.email %>"
                >
            </div>

            <div class="form-group">
                <label for="image">Profile Image</label>
                <input 
                    type="text" 
                    id="image" 
                    name="image"
                    placeholder="Enter Any image"
                    required
                    value="<%= user.image %>"
                >
            </div>

            <button type="submit">Update User</button>
            <!-- <button><a href="/read"></a>All Users</button> -->

        </form>

    </div>

</body>
</html>